# Public mobile configuration only. Never put server credentials in EXPO_PUBLIC_* variables.
# Set this to staging only when EXPO_PUBLIC_API_BASE_URL points to a staging API.
EXPO_PUBLIC_APP_ENV=development
# Replace this safe, non-routable value with the intended development or staging API.
EXPO_PUBLIC_API_BASE_URL=https://api.smartmall.invalid/api/v1